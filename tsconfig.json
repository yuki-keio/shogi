{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types/2023-07-01", "@cloudflare/vitest-pool-workers"],
    "strict": true,
    "resolveJsonModule": true,
    "noEmit": true,
    // この2つはエディタの赤線を消すためだけの設定（このtsconfigを使うnpmスクリプトは無い）。
    // allowImportingTsExtensions: src/kifu/*.ts は互いを `./foo.ts` と拡張子つきで読む
    //   （ブラウザ側は esbuild で束ねるため）。テストがそれを辿るので許可が要る。
    // allowJs: テストが素のJS（pages/legacy-redirect.mjs・name-filter.js）を読む。
    // どちらも noEmit なので出力には影響しない
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/worker/**/*.ts", "test/**/*.ts"]
}
