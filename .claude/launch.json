{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "wrangler-dev",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npx wrangler dev --port \"${PORT:-8787}\""
      ],
      "port": 8787,
      "autoPort": true
    },
    {
      "name": "static-preview",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd dist && python3 -m http.server \"${PORT:-8123}\""
      ],
      "port": 8123,
      "autoPort": true
    }
  ],
  "autoVerify": true
}
