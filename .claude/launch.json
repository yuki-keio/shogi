{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static-dist",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "exec python3 -m http.server \"${PORT:-8794}\" --directory dev/claude-dist"],
      "port": 8794,
      "autoPort": true
    },
    {
      "name": "wrangler-dev",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "DIST_DIR=dev/claude-dist ./build.sh && exec \"$HOME/.claude/scripts/preview-wrangler.sh\" 8795 dev/claude-state --assets dev/claude-dist"],
      "port": 8795,
      "autoPort": true
    }
  ]
}
