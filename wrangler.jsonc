{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-shogi",
  "compatibility_date": "2026-05-23",
  "assets": {
    "directory": "./dist"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.07
  },
  "routes": [
    {
      "pattern": "shogi.yuki-lab.com",
      "custom_domain": true
    }
  ]
}
