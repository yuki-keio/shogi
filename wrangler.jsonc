{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-shogi",
  "compatibility_date": "2026-05-23",
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MATCH_ROOM",
        "class_name": "MatchRoom"
      },
      {
        "name": "MATCHMAKER",
        "class_name": "Matchmaker"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MatchRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Matchmaker"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "web-shogi",
      "database_id": "1155bdd1-90dc-450b-b758-6bdf400bdfb5",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.07
  },
  "routes": [
    {
      "pattern": "shogi.yuki-lab.com",
      "custom_domain": true
    }
  ]
}
