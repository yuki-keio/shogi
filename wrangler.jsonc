{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-shogi",
  "compatibility_date": "2026-05-23",
  "dev": { "port": 8795 },
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // 存在しないURLは dist/404.html を 404 のまま返す（真っ白な画面で離脱させない）
    "not_found_handling": "404-page",
    // 404-page を設定すると、画面遷移のリクエストは Worker を通らなくなる。API は必ず Worker へ
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MATCH_ROOM",
        "class_name": "MatchRoom"
      },
      {
        "name": "MATCHMAKER",
        "class_name": "Matchmaker"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MatchRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Matchmaker"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "web-shogi",
      "database_id": "1155bdd1-90dc-450b-b758-6bdf400bdfb5",
      "migrations_dir": "migrations"
    },
    {
      // だれかと対戦の対局記録（ソフト指し対策）。本体の DB と容量の上限（1データベース10GB）を分けるため別にした
      "binding": "RECORDS",
      "database_name": "web-shogi-records",
      "database_id": "7115bc95-f03e-4cb7-926c-9a6ba5df873d",
      "migrations_dir": "migrations-records"
    },
    {
      // 記録の控え。実力値と容量の上限（1データベース10GB）を分けるため別にした
      "binding": "BACKUP",
      "database_name": "web-shogi-backup",
      "database_id": "9fbae58e-9f5a-4803-b43e-750c7ee1b345",
      "migrations_dir": "migrations-backup"
    }
  ],
  // 1分ごとに、控えを本体の DB の古い表から控え専用の DB へ少しずつ移す（src/worker/backup_move.ts）。
  // 移し終わったら（backup_move.dropped_at が入ったら）"crons": [] にしてデプロイする
  // （triggers ごと消すと、Cloudflare 側の毎分の予定が残る）
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.07
  },
  "routes": [
    {
      "pattern": "shogi.yuki-lab.com",
      "custom_domain": true
    }
  ]
}
